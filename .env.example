# Copy to .env and fill in. .env is ignored by git.

# Your own Databricks CLI profile, created with `databricks auth login`
DATABRICKS_PROFILE=my-profile

# A Unity Catalog catalog in your workspace where you may create a schema
CATALOG=main

# Optional: the Lakebase project id. Use the same id in the README commands.
# PROJECT_ID=lessons-from-lakebase-demo

# Optional: the catalog that setup/06_register_catalog.py creates for the Lakebase database
# LAKEBASE_CATALOG=lessons_from_lakebase_pg

# Optional: full path to the CLI, if `databricks` is not on your PATH
# DATABRICKS_CLI=
